{"name": "Showdown Survivor", "description": "Follow teammates or try to get closer to the center when no enemies and avoids showdown gas", "brawlers": ["all"], "gamemodes": ["trio showdown"], "author": "Official", "date": "2026-07-04"}
def no_enemy_movement():
    player_pos = get_entity_pos(player_data)
    closest_teammate_coords, dist = find_closest_teammate(teammate_data, player_pos, walls)

    if not closest_teammate_coords:
        # The core supplies a target inside an observed corridor. With no gas
        # or allies in view it holds position instead of guessing a map centre.
        center_x, center_y = observed_safe_target

        dx = center_x - player_pos[0]
        dy = center_y - player_pos[1]
        dist_to_center = math.hypot(dx, dy)

        if dist_to_center > 0:
            direction_x, direction_y = dx, dy
        else:
            direction_x, direction_y = 0.0, 0.0

        movement_options = [(direction_x, direction_y), (direction_x, 0), (0, direction_y)]

        for move in movement_options:
            if not is_path_blocked(player_data, move, walls):
                return move
        return (0, 0)
    if dist < TILE_SIZE:
        alternative_moves = [
            (0, -JOYSTICK_RADIUS), (-JOYSTICK_RADIUS, 0),
            (0, JOYSTICK_RADIUS), (JOYSTICK_RADIUS, 0)
        ]
        return random.choice(alternative_moves)

    dx = closest_teammate_coords[0] - player_pos[0]
    dy = closest_teammate_coords[1] - player_pos[1]

    direction_x, direction_y = dx, dy
    movement_options = [(direction_x, direction_y), (direction_x, 0), (0, direction_y)]

    for move in movement_options:
        if not is_path_blocked(player_data, move, walls):
            return move
    else:
        return (0, 0)

def visible_teammates():
    """How many allied detections are visible; off-screen life is unknown.

    At high power a fight is only worth taking with your team next to you. When
    the team is down, every duel is a 1v3, and in Showdown dying is what costs
    trophies, so the bot stops looking for fights and just stays alive.
    """
    return len(teammate_data) if teammate_data else 0  # Visible allies; off-screen life is unknown.

def keep_away_from_enemy(player_pos, enemy_coords):
    """Step off the line to the enemy, preferring a direction that is open.

    Backing straight up often means backing into a wall, which turns a retreat
    into a corner fight, so the sideways options are tried first.
    """
    dx = player_pos[0] - enemy_coords[0]
    dy = player_pos[1] - enemy_coords[1]
    length = math.hypot(dx, dy)
    if length <= 0:
        dx, dy, length = 0.0, 1.0, 1.0
    options = [
        (dx, dy),
        (-dy, dx),
        (dy, -dx),
        (0, -JOYSTICK_RADIUS if dy < 0 else JOYSTICK_RADIUS),
        (-JOYSTICK_RADIUS if dx < 0 else JOYSTICK_RADIUS, 0),
    ]
    for move in options:
        if not is_path_blocked(player_data, move, walls):
            return move
    return (0, 0)

def find_brawler_info(name):
    """Look the brawler up, tolerating a different spelling in the table.

    Some entries are keyed differently from how they are written in the queue
    (Jess is stored as "jessie"), and the playstyle sandbox has no builtins, so
    raising here would not even produce a readable error.
    """
    table = brawlers_info
    if name in table:
        return table[name]
    lowered = str(name).lower()
    for key, info in table.items():
        if str(key).lower() == lowered:
            return info
    for key, info in table.items():
        base = str(key).lower()
        if base.startswith(lowered) or lowered.startswith(base):
            return info
    return None

brawler_info = find_brawler_info(brawler)
if not brawler_info:
    brawler_info = {"hold_attack": 0.0, "super_type": "other", "attack_range": 0,
                    "safe_range": 0, "super_range": 0}
must_brawler_hold_attack = must_brawler_hold_attack(brawler, brawlers_info)
# if a brawler has been holding an attack for its max duration + the bot setting, then we release
if must_brawler_hold_attack and persistent_data["time_since_holding_attack"] is not None and time.time() - persistent_data["time_since_holding_attack"] >= brawler_info['hold_attack'] + seconds_to_hold_attack_after_reaching_max:
    attack(touch_up=True, touch_down=False)
    persistent_data["time_since_holding_attack"] = None

safe_range, attack_range, super_range = get_brawler_range(brawler)
player_pos = get_entity_pos(player_data)
#if debug: print("found player pos:", player_pos)
if not is_there_enemy(enemy_data):
    movement = no_enemy_movement()
else:
    enemy_coords, enemy_distance = find_closest_enemy(enemy_data, player_pos, walls, "attack")
    if enemy_coords is None:
        movement = no_enemy_movement()
    else:
        #if debug: print("found enemy pos:", enemy_coords)
        # Chasing is what puts the bot into gas and into 1v2s. Only close the gap
        # when the team is together and the target is already close by.
        chase_leash = TILE_SIZE * 6
        team_up = visible_teammates() >= 2
        may_close_in = team_up and enemy_distance <= chase_leash

        if may_close_in and enemy_distance > safe_range:
            direction_x = enemy_coords[0] - player_pos[0]
            direction_y = enemy_coords[1] - player_pos[1]
            movement_options = [(direction_x, direction_y), (direction_x, 0), (0, direction_y)]
        else:
            # Either the target is too far to be worth walking to, or the
            # team is gone and a duel would be suicide. Open the distance and
            # let the enemy come to us.
            #
            # Retreat is a proposal; the core validates walls and gas.
            movement_options = [
                keep_away_from_enemy(player_pos, enemy_coords),
                no_enemy_movement(),
            ]

        for move in movement_options:
            if not is_path_blocked(player_data, move, walls):
                movement = move
                break
        else:
            alternative_moves = [(0, -JOYSTICK_RADIUS), (-JOYSTICK_RADIUS, 0), (0, JOYSTICK_RADIUS), (JOYSTICK_RADIUS, 0)]
            random.shuffle(alternative_moves)
            for move in alternative_moves:
                if not is_path_blocked(player_data, move, walls):
                    movement = move
                    break
            else:
                movement = (0, 0)

        if is_super_ready and persistent_data["time_since_holding_attack"] is None:
            super_type = brawler_info['super_type']
            enemy_hittable = is_enemy_hittable(player_pos, enemy_coords, walls, "super")

            # Held back unless the target is inside super range: dumping the
            # super on the first brawler that shows up is how the bot ends up
            # defenceless for the fight that actually decides the placement.
            worth_spending = enemy_distance <= super_range or super_type in ["spawnable", "other"]
            if (enemy_hittable and worth_spending and
                    (enemy_distance <= super_range
                     or super_type in ["spawnable", "other"]
                     or (brawler in ["stu", "surge"] and super_type == "charge" and enemy_distance <= super_range + attack_range)
                    )):
                if is_hypercharge_ready:
                    use_hypercharge()

                use_super()

        # Attack if enemy is within attack range and hittable
        if enemy_distance <= attack_range:
            enemy_hittable = is_enemy_hittable(player_pos, enemy_coords, walls, "attack")
            if enemy_hittable:
                if is_gadget_ready and persistent_data["time_since_holding_attack"] is None:
                    use_gadget()

                if not must_brawler_hold_attack:
                    attack()
                else:
                    if persistent_data["time_since_holding_attack"] is None:
                        persistent_data["time_since_holding_attack"] = time.time()
                        attack(touch_up=False, touch_down=True)
                    elif time.time() - persistent_data["time_since_holding_attack"] >= brawlers_info[brawler]['hold_attack']:
                        attack(touch_up=True, touch_down=False)
                        persistent_data["time_since_holding_attack"] = None
